<Window x:Class="ImageProcessing.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="영상처리 프로그램" Height="800" Width="1180"
        MinWidth="1100" MinHeight="760"
        Loaded="Window_Loaded">

    <!--
        x:Name 규칙 : 종류 약자 + 대상
          Txt = TextBlock,  Rb = RadioButton,  Sld = Slider,  Cmb = ComboBox
          Row = RowDefinition,  Border / Canvas = 그대로
          Viewer = 영상을 보여주는 Image,  Nav = Navigator
    -->

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 왼쪽 : 영상 뷰어 2개 + 히스토그램 ===== -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="270"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 원본 뷰어 (Viewer1) + ROI 드래그용 Canvas (MainWindow.Roi.cs) -->
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,5,0">
                    <DockPanel>
                        <TextBlock Text="원본 (Viewer1)" DockPanel.Dock="Top"
                                   Background="#EEEEEE" Padding="4"/>
                        <Grid>
                            <Image x:Name="Viewer1" Stretch="Uniform" Margin="4"/>
                            <Canvas x:Name="RoiCanvas" Background="Transparent" Margin="4"
                                    MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                    MouseMove="RoiCanvas_MouseMove"
                                    MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp">
                                <Rectangle x:Name="RoiRect" Stroke="Red" StrokeThickness="1"
                                           Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 처리 결과 뷰어 (Viewer2) -->
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0,0,0">
                    <DockPanel>
                        <TextBlock Text="처리 결과 (Viewer2)" DockPanel.Dock="Top"
                                   Background="#EEEEEE" Padding="4"/>
                        <Image x:Name="Viewer2" Stretch="Uniform" Margin="4"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 히스토그램 (MainWindow.Histogram.cs) -->
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="0,10,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="RowR" Height="*"/>
                        <RowDefinition x:Name="RowG" Height="*"/>
                        <RowDefinition x:Name="RowB" Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 히스토그램 대상 선택 : 원본 / 처리 결과 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="RbOriginal" Content="원본" GroupName="HistogramSource"
                                     IsChecked="True" Margin="0,0,12,0" Checked="HistogramSource_Checked"/>
                        <RadioButton x:Name="RbResult" Content="처리 결과" GroupName="HistogramSource"
                                     IsEnabled="False" Checked="HistogramSource_Checked"/>
                        <TextBlock x:Name="TxtRoi" Text="전체 영역" Foreground="Black" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- R 줄 -->
                    <TextBlock x:Name="TxtR" Grid.Row="1" Text="R" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="BorderR" Grid.Row="1" Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="4,0,0,4">
                        <Canvas x:Name="CanvasR" Background="LightGray" ClipToBounds="True"
                                SizeChanged="HistogramCanvas_SizeChanged"/>
                    </Border>

                    <!-- G 줄 -->
                    <TextBlock x:Name="TxtG" Grid.Row="2" Text="G" Foreground="LimeGreen" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="BorderG" Grid.Row="2" Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="4,0,0,4">
                        <Canvas x:Name="CanvasG" Background="LightGray" ClipToBounds="True"
                                SizeChanged="HistogramCanvas_SizeChanged"/>
                    </Border>

                    <!-- B 줄 -->
                    <TextBlock x:Name="TxtB" Grid.Row="3" Text="B" Foreground="DeepSkyBlue" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border x:Name="BorderB" Grid.Row="3" Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="4,0,0,0">
                        <Canvas x:Name="CanvasB" Background="LightGray" ClipToBounds="True"
                                SizeChanged="HistogramCanvas_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 오른쪽 : 채널 / Navigator / 기능 탭 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 채널 선택 (MainWindow.Histogram.cs) -->
            <GroupBox Header="Channel Mode" Grid.Row="0" Margin="0,0,0,8">
                <WrapPanel Margin="6">
                    <RadioButton x:Name="RbColor" Content="Color" GroupName="ChannelMode"
                                 IsChecked="True" Margin="0,0,12,4" Checked="ChannelMode_Checked" Style="{StaticResource RadioButtonSmall}"/>
                    <RadioButton x:Name="RbR" Content="R" GroupName="ChannelMode"
                                 Margin="0,0,12,4" Checked="ChannelMode_Checked" Style="{StaticResource RadioButtonSmall}"/>
                    <RadioButton x:Name="RbG" Content="G" GroupName="ChannelMode"
                                 Margin="0,0,12,4" Checked="ChannelMode_Checked" Style="{StaticResource RadioButtonSmall}"/>
                    <RadioButton x:Name="RbB" Content="B" GroupName="ChannelMode"
                                 Margin="0,0,0,4" Checked="ChannelMode_Checked" Style="{StaticResource RadioButtonSmall}"/>
                </WrapPanel>
            </GroupBox>

            <!-- Navigator (MainWindow.Roi.cs) + 처리 시간 (MainWindow.Processing.cs) -->
            <GroupBox Header="Navigator / 시간" Grid.Row="1" Margin="0,0,0,8">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1"
                            Width="180" Height="150">
                        <Grid>
                            <Image x:Name="NavViewer" Stretch="Uniform"/>
                            <Canvas x:Name="NavCanvas" ClipToBounds="True">
                                <Rectangle x:Name="NavRoiRect" Stroke="Red" StrokeThickness="1"
                                           Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="처리 시간" Foreground="Gray" FontSize="11"/>
                        <!-- Viewbox : 글자가 칸보다 길면 잘리지 않고 칸에 맞게 작아진다 (DownOnly = 커지지는 않음) -->
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtTime" Text="0 ms" FontSize="16" FontWeight="Bold"/>
                        </Viewbox>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <TabControl Grid.Row="2">
                <!-- 파일 (MainWindow.xaml.cs) -->
                <TabItem Header="이미지">
                    <StackPanel Margin="8">
                        <Button Content="열기 (.bmp)" Height="28" Margin="0,0,0,6" Click="BtnOpen_Click" Style="{StaticResource ButtonSmall}"/>
                        <Button Content="저장 (.bmp)" Height="28" Click="BtnSave_Click" Style="{StaticResource ButtonSmall}"/>
                    </StackPanel>
                </TabItem>

                <!-- ROI / 템플릿 등록 (MainWindow.Roi.cs, MainWindow.TemplateMatch.cs) -->
                <TabItem Header="ROI">
                    <StackPanel Margin="8">
                        <Button Content="ROI 취소" Height="28" Margin="0,0,0,6" Click="BtnRoiCancel_Click" Style="{StaticResource ButtonSmall}"/>
                        <Button Content="템플릿 등록" Height="28" Margin="0,0,0,10" Click="BtnRegisterTemplate_Click" Style="{StaticResource ButtonSmall}"/>
                        <TextBlock Text="템플릿" Foreground="Gray" Margin="0,0,0,4"/>
                        <Border BorderBrush="LightGray" BorderThickness="1" Width="150" Height="150" HorizontalAlignment="Left">
                            <Image x:Name="TemplateView" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- 기본 영상처리 (MainWindow.Processing.cs) -->
                <TabItem Header="영상처리">
                    <StackPanel Margin="8">
                        <TextBlock Text="임계값 (0~255)" Foreground="Gray" Margin="0,0,0,4"/>
                        <Slider x:Name="SldThreshold" Minimum="0" Maximum="255" Value="128"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Width="200" HorizontalAlignment="Left" Margin="0,0,0,4"
                                ValueChanged="SldThreshold_ValueChanged"/>
                        <TextBlock x:Name="TxtThreshold" Text="현재 값: 128" Margin="0,0,0,6"/>
                        <Button Content="이진화" Height="28" Margin="0,0,0,6" Click="BtnBinarize_Click" Style="{StaticResource ButtonSmall}"/>
                        <Separator Background="LightGray" Height="1" Margin="0,10"/>
                        <Button Content="팽창" Height="28" Margin="0,0,0,6" Click="BtnDilation_Click" Style="{StaticResource ButtonSmall}"/>
                        <Button Content="수축" Height="28" Margin="0,0,0,6" Click="BtnErosion_Click" Style="{StaticResource ButtonSmall}"/>
                        <Button Content="히스토그램 평활화" Height="28" Margin="0,0,0,10" Click="BtnEqualize_Click" Style="{StaticResource ButtonSmall}"/>
                    </StackPanel>
                </TabItem>

                <!-- 필터 (MainWindow.Processing.cs) -->
                <TabItem Header="필터">
                    <StackPanel Margin="8">
                        <TextBlock Text="Kernel Size" Foreground="Gray" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbKernel" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" SelectedIndex="0" Style="{StaticResource ComboBoxSmall}">
                            <ComboBoxItem Content="3x3"/>
                            <ComboBoxItem Content="5x5"/>
                        </ComboBox>

                        <TextBlock Text="Sigma" Foreground="Gray" Margin="0,0,0,4"/>
                        <Slider x:Name="SldSigma" Minimum="0.5" Maximum="3.0" Value="1.0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Width="200" HorizontalAlignment="Left" Margin="0,0,0,4"
                                ValueChanged="SldSigma_ValueChanged"/>
                        <TextBlock x:Name="TxtSigma" Text="1.0" Margin="0,0,0,10"/>
                        <Button Content="가우시안" Height="28" Margin="0,0,0,6" Click="BtnGaussian_Click" Style="{StaticResource ButtonSmall}"/>
                        <Separator Background="LightGray" Height="1" Margin="0,10"/>
                        <Button Content="라플라시안" Height="28" Margin="0,0,0,6" Click="BtnLaplacian_Click" Style="{StaticResource ButtonSmall}"/>
                        <Button Content="소벨" Height="28" Click="BtnSobel_Click" Style="{StaticResource ButtonSmall}"/>
                    </StackPanel>
                </TabItem>

                <!-- 템플릿 매칭 (MainWindow.TemplateMatch.cs) -->
                <TabItem Header="템플릿 매칭">
                    <StackPanel Margin="8">
                        <Button Content="DIFF" Height="28" Margin="0,0,0,6" Click="BtnDiff_Click" Style="{StaticResource ButtonSmall}"/>
                        <Button Content="CORR" Height="28" Margin="0,0,0,6" Click="BtnCorr_Click" Style="{StaticResource ButtonSmall}"/>
                        <Button Content="COEFF" Height="28" Click="BtnCoeff_Click" Style="{StaticResource ButtonSmall}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
